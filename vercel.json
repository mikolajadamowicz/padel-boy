{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/kluby-proxy/:path(.*)", "destination": "/api/kluby-proxy?path=:path" },
    { "source": "/((?!assets/|api/|kluby-proxy/).*)", "destination": "/index.html" }
  ]
}
