{
  "name": "padel-boy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "test": "vitest run --no-cache",
    "test:watch": "vitest",
    "translate:check": "npm run type-check && npm run test",
    "generate:translation": "tsx src/locales/scripts/generate-translation.ts",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "dejavu-fonts-ttf": "^2.37.3",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run translate:check"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
